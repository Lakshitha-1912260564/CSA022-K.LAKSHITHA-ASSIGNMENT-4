#include <stdio.h>

struct account {
    int number;
    float balance;
};

/* Repaired: accepts a pointer so the original struct in main is updated */
void addInterest(struct account *a, float rate) {
    printf("  [Inside addInterest] address of a = %p\n", (void *)a);
    a->balance = a->balance + (a->balance * rate / 100.0f);
}

int main(void) {
    struct account list[3] = {{101, 5000.0f}, {102, 12000.0f}, {103, 800.0f}};
    struct account *p = list;

    for (int i = 0; i < 3; i++) {
        printf("[In main] address of list[%d] = %p\n", i, (void *)&list[i]);
        addInterest(&list[i], 4.0f);
    }

    printf("\nFirst account via pointer p: %d %.2f\n", p->number, p->balance);
    printf("All updated balances:\n");
    for (int i = 0; i < 3; i++) {
        printf("Account %d: %.2f\n", list[i].number, list[i].balance);
    }
    return 0;
}
